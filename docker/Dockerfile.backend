FROM python:3.11-slim

# Logs reach the host immediately; no .pyc files in the image
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app

# All dependencies ship as wheels, so no system build tools are needed
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# Hosts such as Render pass the port in $PORT. Proxy headers keep generated links on https
# when the app runs behind the platform's load balancer.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
