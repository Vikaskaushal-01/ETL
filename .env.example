# Copy to .env and adjust. Every value is optional; defaults are shown.

# --- Database (falls back to local SQLite when MySQL is unreachable) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=agentic_ai_etl
MYSQL_USER=etl_user
MYSQL_PASSWORD=etl_password
# DATABASE_URL=sqlite:///./agentic_ai_etl.db   # overrides the MySQL settings entirely

# --- LLM: gemini | ollama | mock (offline deterministic engine) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Security ---
ENV=development                  # "production" disables demo reset codes,
                                 # and requires a strong DEFAULT_ADMIN_PASSWORD (12+ characters)
SECRET_KEY=                      # signs session tokens; auto-generated into .secret_key when empty
TOKEN_TTL_SECONDS=43200
DEFAULT_ADMIN_PASSWORD=admin     # password for admin@controlai.net, seeded when no users exist
                                 # (in production "admin" is refused: no admin is created)
SERVICE_API_KEY=                 # lets SnapLogic call the API via the X-API-Key header
CORS_ORIGINS=                    # comma-separated extra origins; the bundled UI needs none
ALLOW_PRIVATE_URLS=false         # allow URL ingestion from private network addresses

# --- Limits & pacing ---
MAX_UPLOAD_MB=100
STALE_PIPELINE_SECONDS=1800
PIPELINE_STEP_DELAY=0
PBI_REFRESH_DELAY=1.2

# --- Scheduled ingestion & run notifications ---
SCHEDULER_ENABLED=true           # run due schedules (Schedules page) inside the server process
SCHEDULER_TICK_SECONDS=30        # how often due schedules are checked
SCHEDULER_WORKERS=2              # schedules that may download and run at the same time
# APP_BASE_URL=https://etl.example.com   # link added to webhook notifications

# --- Hosting (Docker / Render) ---
# PORT=8000                      # port the server listens on; Render sets this itself
# STORAGE_DIR=/var/data          # persistent volume for uploads, reports, logs and the SQLite database
