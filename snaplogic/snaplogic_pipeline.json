{
  "snaplogic_pipeline_version": "3.0.0",
  "pipeline_name": "Autonomous Multi-Agent ETL Pipeline",
  "description": "Watches /app/data/raw on the backend host and runs the full multi-agent pipeline (intake, cleaning, validation and load, reports, Power BI export) for every new file through one authenticated API call, then archives the source file.",
  "parameters": {
    "backend_url": "http://backend:8000",
    "service_api_key": "<value of SERVICE_API_KEY in the backend .env>",
    "run_as_user": "admin@controlai.net"
  },
  "snaps": [
    {
      "id": "snap-001-filereader",
      "type": "com.snaplogic.snaps.binary.FileReader",
      "name": "File Reader (raw intake folder)",
      "properties": {
        "Directory": "/app/data/raw",
        "KeepSourceFile": true,
        "FileFilter": "[^.].*",
        "PollingInterval": "5 sec"
      },
      "routing": {
        "success": "snap-002-run-pipeline"
      }
    },
    {
      "id": "snap-002-run-pipeline",
      "type": "com.snaplogic.snaps.rest.RESTPost",
      "name": "Run ETL pipeline",
      "properties": {
        "HTTPMethod": "POST",
        "RemoteURL": "${backend_url}/api/v1/pipeline/start",
        "HTTPRequestHeader": {
          "Content-Type": "application/json",
          "X-API-Key": "${service_api_key}",
          "X-User-Email": "${run_as_user}"
        },
        "HTTPRequestBody": "{\n  \"file_path\": \"/app/data/raw/${filename}\"\n}"
      },
      "routing": {
        "Response": "snap-003-poll-status"
      }
    },
    {
      "id": "snap-003-poll-status",
      "type": "com.snaplogic.snaps.rest.RESTGet",
      "name": "Wait for completion",
      "properties": {
        "RemoteURL": "${backend_url}/api/v1/pipeline/status?pipeline_id=${pipeline_id}",
        "HTTPRequestHeader": {
          "X-API-Key": "${service_api_key}",
          "X-User-Email": "${run_as_user}"
        },
        "RepeatUntil": "$status != 'Running'",
        "RepeatInterval": "3 sec"
      },
      "routing": {
        "Response": "snap-004-archive-raw"
      }
    },
    {
      "id": "snap-004-archive-raw",
      "type": "com.snaplogic.snaps.binary.FileWriter",
      "name": "Archive processed raw file",
      "properties": {
        "Directory": "/app/data/archive"
      }
    }
  ]
}
